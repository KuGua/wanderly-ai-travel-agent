# Production OpenTelemetry configuration for Grafana Cloud Free.
#
# This file is **NOT** loaded by the application — it is a template for the
# operator / GitHub Actions secret rotation workflow. The actual values
# live in:
#   - AWS Secrets Manager: `travel-agent/otel/grafana-cloud-token`
#   - GitHub Actions secrets: `GRAFANA_CLOUD_OTLP_ENDPOINT`, `GRAFANA_CLOUD_API_TOKEN`
#   - App Runner runtime configuration secrets (referenced by the
#     `.github/workflows/apps-api-deploy.yml` job)
#   - ECS Fargate task definition `secrets` block (same secret, injected as
#     the `OTEL_EXPORTER_OTLP_HEADERS` env var)
#
# DO NOT commit a real bearer token. The deploy workflow substitutes
# `${GRAFANA_CLOUD_API_TOKEN}` from the GitHub Actions secret at runtime.

# OpenTelemetry — production destinations
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# `authorization=Bearer <token>` is set via AWS Secrets Manager and referenced
# as an env var at deploy time. The literal below is a placeholder that
# must NEVER be replaced inline in the .env file.
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer ${GRAFANA_CLOUD_API_TOKEN}

OTEL_SERVICE_NAME=ai-travel-agent-api
OTEL_SDK_DISABLED=false

# 5% head sampling — production default. The verify-trace-end-to-end.sh
# script overrides this to 1.0 for the duration of its probe request only,
# so the verification always succeeds even at low sampling rates.
OTEL_TRACES_SAMPLER_ARG=0.05

# Internal SDK logging — keep noise out of CloudWatch.
OTEL_LOG_LEVEL=warn

# Pino — production logging level. App Runner captures stdout to CloudWatch
# Logs; Fargate uses the `awslogs` driver. Both end up in Grafana Cloud's
# Logs UI after the managed pipeline runs.
LOG_LEVEL=info

# Service identity. The Worker overrides this to `ai-travel-agent-worker`
# in apps/api/src/workers/worker-main.ts. Keep these values in the same
# Secrets Manager entry so rotation is one one action.
NODE_ENV=production