{
  "name": "ai-travel-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "worker": "node dist/workers/worker-main.js",
    "worker:dev": "tsx watch src/workers/worker-main.ts",
    "sidecar": "node dist/location-reference/sidecar-main.js",
    "sidecar:dev": "tsx watch src/location-reference/sidecar-main.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "logs:tail": "tail -F runtime/api-runtime.ndjson runtime/worker-runtime.ndjson",
    "update-lan-host": "tsx scripts/update-lan-host.ts",
    "observability:up": "docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d tempo grafana",
    "observability:stop": "docker compose -f docker-compose.yml -f docker-compose.observability.yml stop grafana tempo",
    "observability:status": "docker compose -f docker-compose.yml -f docker-compose.observability.yml ps tempo grafana",
    "env:init": "node -e \"const fs=require('fs');if(!fs.existsSync('.env')&&fs.existsSync('.env.example')){fs.copyFileSync('.env.example','.env');console.log('Created .env from .env.example');}else{console.log('.env already exists or .env.example missing');}\"",
    "postinstall": "node -e \"const fs=require('fs');if(!fs.existsSync('.env')&&fs.existsSync('.env.example')){fs.copyFileSync('.env.example','.env');console.log('Created .env from .env.example');}\"",
    "test": "vitest run",
    "pretest": "tsx scripts/prepare-test-db.ts",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ scripts/ vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "docs:verify": "tsx scripts/verify-docs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1121.0",
    "@aws-sdk/client-sesv2": "^3.1118.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@openai/agents": "^0.17.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "aws-jwt-verify": "^5.2.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.3.3",
    "openai": "^7.5.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.7",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.29",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
