# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=travelagent
DB_PASSWORD=travelagent
DB_NAME=travelagent

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Model Gateway — set exactly one active provider. With no usable provider/key,
# the service uses the deterministic MockModelGateway.
#
# Supported values:
# - gemini: Google Gemini through its OpenAI-compatible endpoint
# - openai: OpenAI's default endpoint
# - openai-compatible: any provider exposing the OpenAI Chat Completions API
# - mock: force fixture-safe deterministic output
MODEL_GATEWAY_PROVIDER=mock

# Gemini (recommended when MODEL_GATEWAY_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional override, normally leave at Google's OpenAI-compatible endpoint.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenAI (when MODEL_GATEWAY_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Other OpenAI-compatible providers (when MODEL_GATEWAY_PROVIDER=openai-compatible).
# Set this provider's API key, base URL, and model; do not put keys in the client.
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_MODEL=

# Shared LLM settings for every real provider.
MODEL_GATEWAY_PROMPT_VERSION=1.0.0
MODEL_GATEWAY_MAX_RETRIES=1

# Sandbox booking callback — HMAC secret used to verify provider-signed callbacks.
# Required in production; the dev default is logged as a warning if unset.
SANDBOX_HMAC_SECRET=

# Skill registry dedupe (milliseconds). Repeat invocations of a skill that
# produce the same output hash within this window are rejected.
SKILL_DEDUPE_TTL_MS=60000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
