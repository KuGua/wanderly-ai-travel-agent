# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=travelagent
DB_PASSWORD=travelagent
DB_NAME=travelagent

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Model Gateway — set MODEL_GATEWAY_PROVIDER=openai and provide OPENAI_API_KEY
# to call real OpenAI Responses API; otherwise the gateway falls back to the
# deterministic MockModelGateway.
MODEL_GATEWAY_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_PROMPT_VERSION=1.0.0
OPENAI_MAX_RETRIES=1

# Sandbox booking callback — HMAC secret used to verify provider-signed callbacks.
# Required in production; the dev default is logged as a warning if unset.
SANDBOX_HMAC_SECRET=

# Skill registry dedupe (milliseconds). Repeat invocations of a skill that
# produce the same output hash within this window are rejected.
SKILL_DEDUPE_TTL_MS=60000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
