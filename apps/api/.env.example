# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=travelagent
DB_PASSWORD=travelagent
DB_NAME=travelagent
# Tests require loopback and a database or search_path schema ending in `_test`.
TEST_DATABASE_URL=postgres://travelagent:travelagent@127.0.0.1:5432/travelagent?options=-csearch_path%3Dtravelagent_test

# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Authentication — required for protected API routes. The browser signs users
# in through Cognito (email or phone); the API validates access tokens and uses
# the token subject as the database identity. These identifiers are not secrets.
# The anonymous, read-only map location-reference endpoint is the sole exception.
AUTH_MODE=local-dev
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=example-public-app-client-id

# This checked-in example is ready for strict local browser-to-API development.
# The API provisions one server-owned local identity and rejects non-loopback
# clients. local-dev is forbidden in production; the browser sends no fake token.
# Set AUTH_MODE=cognito and provide the pool identifiers for non-local use.

# Model Gateway — required for the API to generate plans. The service never
# substitutes a local model or fabricated plan when this configuration fails.
#
# Supported values:
# - gemini: Google Gemini through its OpenAI-compatible endpoint
# - openai: OpenAI's default endpoint
# - openai-compatible: any provider exposing the OpenAI Chat Completions API
# Choose one: gemini, openai, or openai-compatible.
MODEL_GATEWAY_PROVIDER=gemini

# Gemini (recommended when MODEL_GATEWAY_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional override, normally leave at Google's OpenAI-compatible endpoint.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenAI (when MODEL_GATEWAY_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Other OpenAI-compatible providers (when MODEL_GATEWAY_PROVIDER=openai-compatible).
# Set this provider's API key, base URL, and model; do not put keys in the client.
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_BASE_URL=
MODEL_GATEWAY_MODEL=

# Shared LLM settings for every real provider.
MODEL_GATEWAY_PROMPT_VERSION=1.0.0
MODEL_GATEWAY_MAX_RETRIES=1

# Durable Agent Worker and authenticated SSE observation. The Worker owns task
# execution; closing the browser stream never cancels an accepted task.
AGENT_TASK_LEASE_SECONDS=30
AGENT_TASK_LEASE_RENEW_SECONDS=10
AGENT_TASK_QUEUE_TTL_SECONDS=300
AGENT_WORKER_POLL_INTERVAL_MS=500
AGENT_WORKER_CONCURRENCY=1
AGENT_STREAM_KEEP_ALIVE_MS=15000
AGENT_STREAM_MAX_DELTA_BYTES=1024

# Sandbox booking callback — HMAC secret used to verify provider-signed callbacks.
# Required in every environment that accepts callbacks. Use a local-only random
# value of at least 32 bytes; never commit a real provider secret.
SANDBOX_HMAC_SECRET=replace-with-a-local-random-secret-at-least-32-bytes

# Observability
# Reserved for a future production trace exporter; the MVP does not initialize
# an OpenTelemetry exporter yet.
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
