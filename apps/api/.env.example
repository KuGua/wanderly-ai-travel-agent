# Database overrides are optional for the local Docker defaults. Never put a
# shared, staging, or production password or connection string in this file.
# DATABASE_URL=
# DB_HOST=
# DB_PORT=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# Tests require a loopback database or search_path schema ending in `_test`.
# TEST_DATABASE_URL=

# Optional local data-path override. Leave unset to use versioned repository data.
# LOCATION_REFERENCE_COUNTRIES_PATH=

# Location-reference resolution mode. Drives how `resolveConversationPlace()`
# and `POST /api/v1/explore/location-reference` resolve coordinates:
#   in-process (default) — call `getLocationReferenceResolver()` directly.
#                          Behavior identical to pre-sidecar builds.
#   sidecar              — HTTP `POST /resolve` to `${LOCATION_REFERENCE_SIDECAR_URL}`.
#                          Used for local dev to keep 70 MB of GeoJSON out of
#                          the API process. See `apps/api/src/location-reference/SIDECAR.md`.
#   disabled             — Return `NO_REFERENCE` synchronously without reading
#                          any data file. Cheapest mode for 16 GB Mac end-to-end demos.
LOCATION_REFERENCE_MODE=in-process
# Required only when LOCATION_REFERENCE_MODE=sidecar. The sidecar is bound to
# loopback in `apps/api/docker-compose.yml`; this URL is the API's view of it.
# LOCATION_REFERENCE_SIDECAR_URL=http://127.0.0.1:3002
# Optional. Integer milliseconds 1..30000. Default 2000.
# LOCATION_REFERENCE_SIDECAR_TIMEOUT_MS=2000

# ─── Location Introduction (anonymous, shared cache) ────────────────────────
# S4 / docs/location-introduction-cache-implementation.md §5.
# These defaults ship with the API; override only when integrating a new
# catalog, debugging, or stress-testing.

# Bundled, versioned catalog of stable map places eligible for cached
# introductions. Path is resolved relative to the working directory,
# which is `apps/api` for the API process.
# LOCATION_INTRODUCTION_CATALOG_PATH=data/location-introduction/catalog.json

# Cache-key content version. Bump this value (e.g. location-intro-v2) to
# invalidate all previously cached entries on next deploy; the next request
# for any place regenerates under the new key.
# LOCATION_INTRODUCTION_CONTENT_VERSION=location-intro-v1

# Cache TTL (seconds). Default 604800 (7 days). Past expires_at the row is
# treated as a miss on the next read and the lease path regenerates.
# LOCATION_INTRODUCTION_TTL_SECONDS=604800

# Generation lease (seconds). Default 20. While a lease is held, all other
# callers receive 202 GENERATING with retryAfterMs.
# LOCATION_INTRODUCTION_GENERATION_LEASE_SECONDS=20

# Server-owned model deadline (milliseconds). It is independent of a browser
# request, so a user closing the drawer does not cancel a cache generation.
# LOCATION_INTRODUCTION_GENERATION_TIMEOUT_MS=60000

# Per-IP anonymous rate limit (requests per window). Default 10/min.
# LOCATION_INTRODUCTION_RATE_LIMIT=10

# Rate-limit window (milliseconds). Default 60000 (1 minute).
# LOCATION_INTRODUCTION_RATE_WINDOW_MS=60000

# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Authentication — required for protected API routes. The browser signs users
# in through Cognito (email or phone); the API validates access tokens and uses
# the token subject as the database identity. These identifiers are not secrets.
# The anonymous, read-only map location-reference endpoint is the sole exception.
AUTH_MODE=custom-local
# Required when AUTH_MODE=local-dev or custom-local. Every listed origin must be an exact
# loopback HTTP origin; this prevents another website from using local authentication.
LOCAL_DEV_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Required when AUTH_MODE=custom-local. Use a unique local secret; never commit its value.
JWT_SECRET=<generate-a-local-secret>
# Required for email-bound invitation matching. Generate at least 32 random
# characters and keep it stable; never put a recipient email in logs or audit data.
INVITATION_EMAIL_HMAC_SECRET=<generate-a-stable-32-plus-character-secret>
# Required only when AUTH_MODE=cognito. These are identifiers, not secrets.
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# This checked-in example is ready for strict local browser-to-API development.
# custom-local is the loopback-only, database-backed multi-user mode for isolation tests.
# local-dev instead provisions one server-owned fixed identity for single-user smoke tests.
# Both local modes are forbidden in production. Set AUTH_MODE=cognito for non-local use.

# Password reset for the custom username/password flow. `direct` skips email
# verification and is for the current non-production prototype only. Switch to
# `email-code` when an email sender is available. The deployed demo also uses
# direct mode until that integration is ready.
PASSWORD_RESET_MODE=direct
# Required only for `email-code` in production. The runtime IAM role needs
# `ses:SendEmail` for the verified sender/domain.
# AWS_REGION=us-east-1
# PASSWORD_RESET_FROM_EMAIL=no-reply@example.com

# Model Gateway — required for the API to generate plans. The service never
# substitutes a local model or fabricated plan when this configuration fails.
#
# Supported values:
# - gemini: Google Gemini through its OpenAI-compatible endpoint
# - openai: OpenAI's default endpoint
# - openai-compatible: any provider exposing the OpenAI Chat Completions API
# Choose one: gemini, openai, or openai-compatible.
MODEL_GATEWAY_PROVIDER=gemini

# One server-side key for the explicitly selected provider. Required before any
# model-backed request; leave empty in this example and never commit a real key.
MODEL_GATEWAY_API_KEY=
# This local example explicitly selects the lower-cost Gemini Lite model. The
# runtime requires a provider, model, and key explicitly; other compatible
# providers also require a base URL.
MODEL_GATEWAY_MODEL=gemini-3.1-flash-lite
# MODEL_GATEWAY_BASE_URL=

# Shared LLM settings for every real provider.
MODEL_GATEWAY_PROMPT_VERSION=1.0.0
# Default bumped from 1 to 3 to absorb short Gemini / proxy blips within a single
# task. Set to 0 to disable retries; set higher (e.g. 5) only when the calling
# skill has a generous timeoutMs to absorb the cumulative wall-clock.
MODEL_GATEWAY_MAX_RETRIES=3
# Exponential-backoff knobs (jitter applied on top). Each retry sleeps
# `min(BASE * 2^attempt, MAX) + random(0..min(200, exp))` ms.
MODEL_GATEWAY_BASE_BACKOFF_MS=250
MODEL_GATEWAY_MAX_BACKOFF_MS=2000

# Model function-tool calling is disabled until the configured OpenAI-compatible
# provider passes the compatibility spike (schema, multi-turn, timeout and
# cancellation). It does not grant the model direct network or credential access.
MODEL_GATEWAY_TOOL_CALLING_ENABLED=false
MODEL_GATEWAY_TOOL_CALLING_MAX_TURNS=8

# Flight provider selection. This controls only the server-side adapter behind
# the provider-neutral `flight.search` Skill; it is never client-selectable.
# Use `disabled` unless exactly one configured live provider is selected.
FLIGHT_PROVIDER=disabled

# Amadeus Self-Service Flight Offers Search. `test` is only for local/test
# adapter validation and must never be enabled in production-like environments.
# `production` requires both credentials and returns no substitute data when
# unavailable. Values are server-side secrets; never expose them to the browser.
AMADEUS_ENVIRONMENT=disabled
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_FLIGHT_TIMEOUT_MS=8000

# FlightAPI.io Flight Price API. Its API key is part of the request URL path,
# so the adapter never logs, persists, returns, or attaches the full URL to an
# error. This is a live-credit provider: automated tests must mock HTTP.
# Set FLIGHT_PROVIDER=flightapi and add the key only in an ignored runtime env.
# FLIGHTAPI_API_KEY=
# FLIGHTAPI_FLIGHT_TIMEOUT_MS=15000

# SerpAPI Google Flights. Its API key is a request query parameter, so the
# adapter never logs, persists, returns, or attaches the complete URL to an
# error. This is a live-credit provider: automated tests must mock HTTP.
# Set FLIGHT_PROVIDER=serpapi and add the key only in an ignored runtime env.
# SERPAPI_API_KEY=
# SERPAPI_FLIGHT_TIMEOUT_MS=15000
# SERPAPI_GOOGLE_FLIGHTS_GL=us
# SERPAPI_GOOGLE_FLIGHTS_HL=en

# ─── Global POI & ground mobility (docs/ground-mobility-implementation.md §7) ──
# ORS Place / Directions are mandatory for places.search and navigation.route.
# Leave ORS_API_KEY unset to keep the providers at UNAVAILABLE/NOT_CONFIGURED —
# planning then terminates as COMPLETED_WITH_GAPS without ever calling ORS.
# Values are server-side secrets; the browser never sees them.
# ORS_API_KEY=
# ORS_BASE_URL=https://api.openrouteservice.org
# ORS_PLACE_TIMEOUT_MS=8000
# ORS_DIRECTIONS_TIMEOUT_MS=10000

# Per-run caps enforced by the Shared skill layer. PLAN_MAX_PLACE_SEARCHES is
# the maximum number of `places.search` invocations per agent task run;
# PLAN_MAX_ROUTE_QUERIES is the maximum number of `navigation.route`
# invocations per agent task run. Both are integer 1..50.
PLAN_MAX_PLACE_SEARCHES=6
PLAN_MAX_ROUTE_QUERIES=24

# Mobility offers (Amadeus Transfer Search). Disabled by default; flip to
# `true` only after ORS Place/Directions are confirmed working. Until then the
# provider reports UNAVAILABLE/NOT_CONFIGURED and planning does not enqueue any
# transfer research.
PLAN_ENABLE_MOBILITY=false
# AMADEUS_TRANSFER_TIMEOUT_MS=8000

# Viator Experiences MCP — no Affiliate account or API key is required.
# Explicitly opt in because enabling it allows the Worker to make outbound
# requests to Viator during Shared PLAN/REPLAN tool calls. The model and browser
# never receive this URL and cannot supply free-form provider queries.
VIATOR_MCP_ENABLED=false
# Official endpoint; override only for a controlled compatible test server.
VIATOR_MCP_URL=https://exp-app-mcp.prod.ep.viator.com/mcp
# Per-attempt deadline: integer 500..30000 ms. Retries: integer 0..2.
VIATOR_MCP_TIMEOUT_MS=8000
VIATOR_MCP_MAX_RETRIES=1

# SerpApi Google Hotels — self-service key, no supplier order or deep link.
# Disabled and fail-closed by default. Obtain a key at https://serpapi.com/.
SERPAPI_HOTEL_ENABLED=false
# SERPAPI_API_KEY=
# SERPAPI_HOTEL_TIMEOUT_MS=10000
# SERPAPI_HOTEL_MAX_RETRIES=1
# Maximum accepted distance from the canonical city centre. Properties without
# coordinates or outside this radius are discarded instead of risking a wrong city.
SERPAPI_HOTEL_MAX_DISTANCE_KM=75

# ─── Hotel provider switch (docs/nuitee-serpapi-hotel-provider-switching-implementation.md) ──
# `HOTEL_PROVIDER` controls the live hotel quote adapter used for newly
# accepted PLAN/REPLAN/RESEARCH tasks. Existing tasks keep whatever provider
# they were bound to — flipping this env var NEVER rewrites in-flight work.
# Valid values: `disabled` (no adapter; UNAVAILABLE/NOT_CONFIGURED),
# `nuitee` (Nuitee Connect / LiteAPI Rates; default when configured),
# `serpapi` (legacy SerpApi Google Hotels).
# HOTEL_PROVIDER=disabled
#
# Nuitee Connect / LiteAPI Rates REST adapter (POST /v3.0/hotels/rates).
# Multi-room is supported natively; the adapter enforces 1..8 rooms and
# 1..8 adults per room. Each quote also requires a user-confirmed
# `guest_nationality` (ISO-3166-1 alpha-2) — see
# `stay_search_provider_authorizations` and the PUT endpoint below.
# NUITEE_API_KEY=
# NUITEE_BASE_URL=https://api.liteapi.travel
# NUITEE_HOTEL_TIMEOUT_MS=12000
# NUITEE_HOTEL_MAX_RETRIES=1
#
# AWS KMS key ARN or alias used to encrypt/decrypt provider-only quote fields
# (e.g. `guest_nationality`). The API role needs kms:Encrypt and kms:Decrypt
# for this key. When unset or inaccessible, the authorization endpoint refuses
# writes and Nuitee quotes cannot execute; there is no local/random-key fallback.
# NUITEE_NATIONALITY_KMS_KEY_ID=

# OpenTripMap non-price accommodation discovery. The free plan is restricted
# to non-commercial use (5,000 requests/day, 10 requests/second as verified
# 2026-08-30). Keep the key server-side and review the paid terms before any
# commercial deployment. Results carry OpenStreetMap attribution and are not
# availability, price or official hotel-class evidence.
OPENTRIPMAP_ACCOMMODATION_ENABLED=false
# OPENTRIPMAP_API_KEY=
OPENTRIPMAP_BASE_URL=https://api.opentripmap.com/0.1
OPENTRIPMAP_TIMEOUT_MS=8000
OPENTRIPMAP_ACCOMMODATION_RADIUS_METERS=10000
OPENTRIPMAP_ACCOMMODATION_MAX_RESULTS=20

# Expose activities.search to Shared planning only after the configured model
# has passed the existing function-tool calling spike. When false, the Tool is
# not advertised and existing planning behavior is unchanged.
PLAN_ENABLE_ACTIVITIES=false

# ORS-backed Shared planning tools. Both default to false until the configured
# model has passed the function-tool calling spike for the new JSON Schema
# shapes. Enable only after ORS_API_KEY is set and validated.
# `places.adopt` follows `places.search` — there is no separate flag.
PLAN_ENABLE_PLACES=false
PLAN_ENABLE_NAVIGATION=false

# Expose non-price accommodation discovery independently of live hotel quotes.
PLAN_ENABLE_ACCOMMODATION_DISCOVERY=false
# Expose SerpApi live quotes only after the trip has confirmed exact stay
# search preferences (dates come from snapshot; occupancy/currency from the
# confirmed preference version). Broad destination exploration should leave
# this false to preserve the monthly SerpApi quota.
PLAN_ENABLE_HOTEL=false

# Durable Agent Worker and authenticated SSE observation. The Worker owns task
# execution; closing the browser stream never cancels an accepted task. Values
# are bounded and contain no credentials.
AGENT_TASK_LEASE_SECONDS=30
AGENT_TASK_LEASE_RENEW_SECONDS=10
AGENT_TASK_QUEUE_TTL_SECONDS=300
AGENT_WORKER_POLL_INTERVAL_MS=500
AGENT_WORKER_CONCURRENCY=1
AGENT_STREAM_KEEP_ALIVE_MS=15000
AGENT_STREAM_MAX_DELTA_BYTES=1024

# Same-thread Personal Agent context. The Worker reads only complete recent
# USER→ASSISTANT turns from the owner’s current thread, then applies both
# limits. These values are server-side only; the browser cannot override them.
# Turn limit: integer 1..12 (default 8). Character limit: integer 1..20000
# UTF-16 characters (default 12000). Raising either value increases model
# input cost and latency; never use these variables to enable cross-thread or
# whole-archive memory.
CONVERSATION_CONTEXT_MAX_TURNS=8
CONVERSATION_CONTEXT_MAX_CHARS=12000

# Sandbox booking callback — HMAC secret used to verify provider-signed callbacks.
# Required in every environment that accepts callbacks. Before testing one,
# generate a local-only random value of at least 32 bytes; never commit it.
SANDBOX_HMAC_SECRET=

# Observability
LOG_LEVEL=info

# Optional local NDJSON diagnostic copy. This is a Pino sink independent of
# OpenTelemetry, so it still captures safe runtime lifecycle events when OTLP
# is absent or unreachable. The value must be a simple filename; files are
# written under apps/api/runtime/ (ignored by Git). It never records prompts,
# completions, tool arguments/results, credentials, or private profile data.
# LOCAL_DEBUG_LOG_FILE=agent-runtime.ndjson
# Docker Compose uses separate values for the API and Worker so they never
# append to the same file. Leave both empty to disable the optional sink.
# API_LOCAL_DEBUG_LOG_FILE=api-runtime.ndjson
# WORKER_LOCAL_DEBUG_LOG_FILE=worker-runtime.ndjson

# Distributed tracing (OpenTelemetry). The API and Worker only export spans
# when OTEL_EXPORTER_OTLP_ENDPOINT is set; otherwise spans stay in-process or
# are dropped in tests via an in-memory exporter. PII and high-cardinality
# identifiers are filtered out at the span-attribute layer — see
# apps/api/src/observability/tracing.ts#FORBIDDEN_SPAN_ATTRIBUTE_KEYS.
#
# Service identity (default `ai-travel-agent-api`; worker overrides to
# `ai-travel-agent-worker` in apps/api/src/workers/worker-main.ts).
# OTEL_SERVICE_NAME=ai-travel-agent-api

# Disable the SDK entirely; the default keeps spans in-process.
# OTEL_SDK_DISABLED=true

# Exporter selection: in-memory under NODE_ENV=test, console in dev (default),
# otlp when OTEL_TRACES_EXPORTER=otlp and OTEL_EXPORTER_OTLP_ENDPOINT is set.
# OTEL_TRACES_EXPORTER=otlp
# The OTLP/HTTP exporter appends /v1/traces; use the collector base URL.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf    (also accepts "grpc"; falls back to http/protobuf)

# Auth header for SaaS backends (Grafana Cloud, Honeycomb, etc.). The token
# lives in AWS Secrets Manager / App Runner runtime secret / GitHub Actions
# secret — never commit it.
# OTEL_EXPORTER_OTLP_HEADERS="authorization=Bearer <GRAFANA_CLOUD_API_TOKEN>"

# Sampling: dev/test use AlwaysOn (1.0); prod uses parent-based TraceIdRatioBased.
OTEL_TRACES_SAMPLER_ARG=1.0

# SDK internal logging: debug, info, warn, error (default warn).
# OTEL_LOG_LEVEL=warn
# OTEL_LOG_LEVEL=warn

# ─── Long-term memory scoring ────────────────────────────────────────────────
# Behaviour-derived preference *suggestions* are ranked with ACT-R base-level
# activation (Petrov hybrid). These two knobs are the only runtime overrides;
# every other rule is a versioned constant so historical suggestions stay
# explainable. See docs/long-term-memory-implementation.md section 3.5.
#
# Decay exponent d. Must satisfy 0 < d < 1; an out-of-range value fails at
# startup rather than falling back. Lower = memories fade more slowly.
# Default 0.35 is an initial product prior, not a value fitted to travel data.
# MEMORY_ACTIVATION_DECAY=0.35
#
# Minimum activation B a candidate must reach before it is shown at all.
# Raise it to make suggestions rarer. Default 0.50.
# MEMORY_ACTIVATION_THRESHOLD=0.50
