# Optional browser-visible Fastify origin override. The client defaults to
# http://localhost:3000 and appends /api/v1. Never include secrets or private data.
# NEXT_PUBLIC_API_BASE_URL=

# Authentication UI mode. Keep cognito for normal environments. A local Web
# dev server may use local-dev only with the API's strictly loopback local-dev mode;
# it sends no bearer token and does not pretend a Cognito session exists. In that
# mode this URL must be an exact loopback HTTP origin accepted by
# LOCAL_DEV_ALLOWED_ORIGINS on the API.
NEXT_PUBLIC_AUTH_MODE=local-dev

# Required only when NEXT_PUBLIC_AUTH_MODE=cognito. These public identifiers must
# match the API's COGNITO_USER_POOL_ID and COGNITO_CLIENT_ID; the app client must
# not have a secret.
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=
# NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Optional MapLibre style override. The app defaults to OpenFreeMap Liberty,
# which requires visible attribution. Never put private map secrets here.
# NEXT_PUBLIC_MAP_STYLE_URL=
