# Browser-visible Fastify origin. Do not include secrets, credentials, or private data.
# Required in api mode. The client appends /api/v1 to this origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# fixture: deterministic local contract fixtures (default)
# api: real Fastify requests using the signed-in user's Cognito Bearer token
NEXT_PUBLIC_DATA_MODE=fixture
