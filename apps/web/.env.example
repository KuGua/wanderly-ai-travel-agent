# Browser-visible Fastify origin. Do not include secrets, credentials, or private data.
# Required in api mode. The client appends /api/v1 to this origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Authentication UI mode. Keep cognito for normal environments. A local Web
# dev server may use local-dev only with the API's strictly loopback local-dev mode;
# it sends no bearer token and does not pretend a Cognito session exists. In that
# mode this URL must be an exact loopback HTTP origin accepted by
# LOCAL_DEV_ALLOWED_ORIGINS on the API.
NEXT_PUBLIC_AUTH_MODE=local-dev

# Public Cognito User Pool identifiers used by AWS Amplify Auth for private API
# features. These are configuration, not credentials. Use the same pool/client as
# the API's COGNITO_USER_POOL_ID and COGNITO_CLIENT_ID. The app client must not have
# a secret. They may be omitted for the anonymous map location-reference-only demo.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_example
NEXT_PUBLIC_COGNITO_CLIENT_ID=example-public-app-client-id

# OpenFreeMap Liberty is MapLibre-compatible and requires visible attribution.
# Never put private map secrets in a NEXT_PUBLIC_* value.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
