# Browser-visible local Fastify origin. The client appends /api/v1. Never include
# secrets or private data. local-dev must use a loopback API URL; custom-local
# may use a private IPv4 API URL for an explicit trusted-LAN test.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Authentication UI mode. Keep cognito for normal environments. `custom-local`
# uses the API-owned username/password flow for multi-user tests.
# `local-dev` sends no bearer token and uses the API's fixed single-user identity.
# local-dev requires a loopback URL. custom-local may use an exact private IPv4 URL
# accepted by LOCAL_DEV_ALLOWED_ORIGINS on the API for trusted-LAN testing.
NEXT_PUBLIC_AUTH_MODE=custom-local

# Required only when NEXT_PUBLIC_AUTH_MODE=cognito. These public identifiers must
# match the API's COGNITO_USER_POOL_ID and COGNITO_CLIENT_ID; the app client must
# not have a secret.
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=
# NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Team local map baseline. OpenFreeMap Liberty requires visible attribution.
# Never put private map secrets in a NEXT_PUBLIC_* value.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# The browser does not emit OpenTelemetry trace context. It sends only the
# authenticated, allow-listed diagnostics documented in
# docs/frontend-observability.md to the existing API, which then writes safe
# local logs and Tempo traces. Browser OTel remains gated on privacy review:
# nationality, prompt, document fields and unauthorised profile data must
# never be captured.
