# Browser-visible local Fastify origin. The client appends /api/v1. Never include
# secrets or private data; local-dev must use a loopback API URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Authentication UI mode. Keep cognito for normal environments. `custom` uses
# the API-owned username/password prototype and its password-reset endpoints. A local Web
# dev server may use local-dev only with the API's strictly loopback local-dev mode;
# it sends no bearer token and does not pretend a Cognito session exists. In that
# mode this URL must be an exact loopback HTTP origin accepted by
# LOCAL_DEV_ALLOWED_ORIGINS on the API.
NEXT_PUBLIC_AUTH_MODE=local-dev

# Required only when NEXT_PUBLIC_AUTH_MODE=cognito. These public identifiers must
# match the API's COGNITO_USER_POOL_ID and COGNITO_CLIENT_ID; the app client must
# not have a secret.
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=
# NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Team local map baseline. OpenFreeMap Liberty requires visible attribution.
# Never put private map secrets in a NEXT_PUBLIC_* value.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# The browser does not yet emit OpenTelemetry trace context — see
# apps/api/.env.example for backend OTel vars. Browser OTel instrumentation is
# gated on a privacy review per docs/frontend-ui-plan.md (nationality, prompt,
# document fields, and unauthorised profile data must never be captured).
